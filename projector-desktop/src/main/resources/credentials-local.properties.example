# Local-only desktop API host (not committed).
#
# Setup:
# 1. Copy this file to credentials-local.properties (same folder).
#    credentials-local.properties is gitignored.
# 2. Uncomment and set one of the options below.
# 3. Rebuild / restart desktop.
#
# Must match Projector-server application-local.properties (server.port).
# See Projector-server/docs/http-local-port.md.
#
# port=8400
# domain=localhost:8400
#
# Alternative: set env PORT=8400 (used if this file has no port/domain).
