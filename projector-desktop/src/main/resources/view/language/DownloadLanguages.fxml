<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ProgressBar?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>
<BorderPane prefHeight="520.0" prefWidth="480.0" xmlns="http://javafx.com/javafx/8.0.121"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="projector.controller.language.DownloadLanguagesController">
    <top>
        <VBox spacing="8.0" styleClass="download-header">
            <Label fx:id="label" managed="false" styleClass="download-status-label" visible="false"/>
            <HBox alignment="CENTER_LEFT" spacing="10.0">
                <ProgressBar fx:id="languageListProgressBar" managed="false" maxWidth="1.7976931348623157E308"
                             prefWidth="200.0" visible="false" HBox.hgrow="ALWAYS"/>
            </HBox>
            <Label styleClass="utils-section-heading" text="%Select languages"/>
            <Label fx:id="migrationWarningLabel" managed="false" styleClass="download-warning-label"
                   text="%Fork mirror migration warning short" visible="false" wrapText="true"/>
        </VBox>
    </top>
    <center>
        <ScrollPane fitToWidth="true">
            <VBox fx:id="listView" spacing="10.0">
                <padding>
                    <Insets bottom="12.0" left="16.0" right="16.0" top="4.0"/>
                </padding>
            </VBox>
        </ScrollPane>
    </center>
    <bottom>
        <HBox alignment="CENTER_RIGHT" spacing="8.0">
            <padding>
                <Insets bottom="12.0" left="16.0" right="16.0" top="8.0"/>
            </padding>
            <Button fx:id="selectButton" defaultButton="true" text="%Download selected count"/>
        </HBox>
    </bottom>
</BorderPane>
