<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ListView?>
<?import javafx.scene.control.ProgressBar?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.ColumnConstraints?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.RowConstraints?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.TextFlow?>
<BorderPane prefHeight="520.0" prefWidth="720.0" xmlns="http://javafx.com/javafx/8.0.121"
            xmlns:fx="http://javafx.com/fxml/1" fx:controller="projector.controller.song.DownloadSongsController">
    <top>
        <VBox spacing="8.0" styleClass="download-header">
            <Label fx:id="downloadingLabel" styleClass="utils-section-heading" text="%Downloading"/>
            <HBox alignment="CENTER_LEFT" spacing="10.0">
                <ProgressBar fx:id="downloadProgressBar" maxWidth="1.7976931348623157E308" prefWidth="400.0"
                             progress="0.0" HBox.hgrow="ALWAYS"/>
                <Label fx:id="downloadProgressCountLabel" styleClass="download-progress-count"/>
            </HBox>
            <Label fx:id="migrationWarningLabel" managed="false" styleClass="download-warning-label"
                   text="%Fork mirror migration warning" visible="false" wrapText="true"/>
        </VBox>
    </top>
    <left>
        <BorderPane>
            <padding>
                <Insets bottom="8.0" left="8.0" right="4.0" top="4.0"/>
            </padding>
            <top>
                <Label styleClass="utils-section-heading" text="%New song"/>
            </top>
            <center>
                <ListView fx:id="newSongListView" prefHeight="200.0" prefWidth="220.0" BorderPane.alignment="CENTER">
                    <BorderPane.margin>
                        <Insets bottom="4.0" left="4.0" right="4.0" top="8.0"/>
                    </BorderPane.margin>
                </ListView>
            </center>
        </BorderPane>
    </left>
    <center>
        <StackPane>
            <Label fx:id="downloadPlaceholderLabel" styleClass="download-placeholder-label"
                   text="%Download in progress" wrapText="true"/>
            <GridPane fx:id="conflictGridPane" visible="false">
                <columnConstraints>
                    <ColumnConstraints hgrow="ALWAYS"/>
                    <ColumnConstraints hgrow="ALWAYS"/>
                </columnConstraints>
                <rowConstraints>
                    <RowConstraints maxHeight="-Infinity" minHeight="30.0" prefHeight="30.0" vgrow="SOMETIMES"/>
                    <RowConstraints maxHeight="-Infinity" minHeight="30.0" prefHeight="30.0" vgrow="SOMETIMES"/>
                    <RowConstraints vgrow="ALWAYS"/>
                    <RowConstraints minHeight="30.0" prefHeight="40.0" vgrow="NEVER"/>
                </rowConstraints>
                <BorderPane GridPane.columnSpan="2147483647">
                    <center>
                        <Label fx:id="conflictTitle"/>
                    </center>
                    <left>
                        <Label text="%Conflict" BorderPane.alignment="CENTER"/>
                    </left>
                </BorderPane>
                <Label text="%Your version" GridPane.rowIndex="1"/>
                <ScrollPane GridPane.rowIndex="2">
                    <TextFlow fx:id="conflictLocalSongTextFlow">
                        <GridPane.margin>
                            <Insets bottom="4.0" left="4.0" right="4.0" top="4.0"/>
                        </GridPane.margin>
                    </TextFlow>
                </ScrollPane>
                <Label text="%Online version" GridPane.columnIndex="1" GridPane.rowIndex="1"/>
                <ScrollPane GridPane.columnIndex="1" GridPane.rowIndex="2">
                    <TextFlow fx:id="conflictSongTextFlow">
                        <GridPane.margin>
                            <Insets bottom="4.0" left="4.0" right="4.0" top="4.0"/>
                        </GridPane.margin>
                    </TextFlow>
                </ScrollPane>
                <BorderPane GridPane.columnSpan="2" GridPane.rowIndex="3">
                    <center>
                        <HBox alignment="CENTER" spacing="15" BorderPane.alignment="CENTER">
                            <Button fx:id="keepButton" mnemonicParsing="false" text="%Keep local"/>
                            <Button fx:id="acceptBothButton" mnemonicParsing="false" text="%Accept both"/>
                            <Button fx:id="acceptButton" mnemonicParsing="false" text="%Accept new"/>
                        </HBox>
                    </center>
                </BorderPane>
            </GridPane>
        </StackPane>
    </center>
    <bottom>
        <HBox alignment="CENTER_RIGHT" spacing="12.0">
            <padding>
                <Insets bottom="12.0" left="16.0" right="16.0" top="8.0"/>
            </padding>
            <Label fx:id="downloadCompleteHintLabel" managed="false" styleClass="download-status-label"
                   text="%Download complete close hint" visible="false" wrapText="true"/>
            <Button fx:id="closeWindowButton" defaultButton="true" managed="false" text="%Close" visible="false"/>
        </HBox>
    </bottom>
</BorderPane>
