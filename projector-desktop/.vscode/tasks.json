{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Build Desktop Production",
      "type": "shell",
      "command": "python",
      "args": [
        "${workspaceFolder}/createProd.py"
      ],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "group": {
        "kind": "build",
        "isDefault": true
      },
      "icon": {
        "id": "package",
        "color": "terminal.ansiYellow"
      },
      "presentation": {
        "reveal": "always",
        "panel": "shared",
        "focus": true
      },
      "problemMatcher": []
    },
    {
      "label": "Deploy Desktop Production",
      "type": "shell",
      "command": "python",
      "args": [
        "${workspaceFolder}/deploy.py"
      ],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "group": {
        "kind": "build",
        "isDefault": false
      },
      "icon": {
        "id": "cloud-upload",
        "color": "terminal.ansiGreen"
      },
      "presentation": {
        "reveal": "always",
        "panel": "shared",
        "focus": true
      },
      "problemMatcher": []
    }
  ]
}
